# =============================================================================
# AI Pitch Coach - Environment Configuration (Local SOTA Edition)
# =============================================================================

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
# Leave empty to auto-generate a random key in data/secret.key on first run.
SECRET_KEY=
# Set to true when serving over HTTPS.
SECURE_COOKIES=false

# Database: SQLite for local standalone development, PostgreSQL for Docker
DATABASE_URL=sqlite:///./data/pitch_coach.db
# In Docker: DATABASE_URL=postgresql://pitchcoach:pitchcoach_secret@db:5432/pitchcoach

# Default LLM
DEFAULT_LLM=ollama
DEFAULT_MODEL=qwen3:0.6b
OLLAMA_ENDPOINT=http://localhost:11434

# Speech-to-Text (faster-whisper)
WHISPER_MODEL_SIZE=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
PRELOAD_STT_MODEL=false

# Text-to-Speech (Piper)
PIPER_VOICE=en_US-lessac-medium
PRELOAD_TTS_MODEL=false

# MCP Web Search Tool
MCP_ENABLED=true
MCP_AUTO_SEARCH=true
MCP_MAX_RESULTS=5

# Optional default cloud API keys (You can also input them directly in the UI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# AI Pitch Coach - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your API keys

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Only providers with valid API keys will be enabled.
# At least one provider must be available (Ollama is always enabled if running).

# OpenAI
OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_ENDPOINT=https://api.anthropic.com
ANTHROPIC_API_KEY=

# Google (Gemini)
GOOGLE_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# DeepSeek
DEEPSEEK_ENDPOINT=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Mistral
MISTRAL_ENDPOINT=https://api.mistral.ai/v1
MISTRAL_API_KEY=

# Grok (xAI)
GROK_ENDPOINT=https://api.x.ai/v1
GROK_API_KEY=

# Ollama (Local - Always Available)
OLLAMA_ENDPOINT=http://localhost:11434

# Alibaba (DashScope)
ALIBABA_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEY=

# ModelScope
MODELSCOPE_ENDPOINT=https://api-inference.modelscope.cn/v1
MODELSCOPE_API_KEY=

# Moonshot
MOONSHOT_ENDPOINT=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=

# Unbound
UNBOUND_ENDPOINT=https://api.getunbound.ai
UNBOUND_API_KEY=

# SiliconFlow
SiliconFLOW_ENDPOINT=https://api.siliconflow.cn/v1/
SiliconFLOW_API_KEY=

# IBM watsonx
IBM_ENDPOINT=https://us-south.ml.cloud.ibm.com
IBM_API_KEY=
IBM_PROJECT_ID=

# =============================================================================
# Supabase Configuration
# =============================================================================
# Local Supabase or cloud Supabase project URL.
SUPABASE_URL=

# Browser-facing key for auth/session flows.
SUPABASE_ANON_KEY=

# Backend-only key for session persistence and admin database access.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres connection string for migrations/CLI tooling.
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# =============================================================================
# Session / Storage Options
# =============================================================================
SESSION_CONTEXT_WINDOW=8
AUTO_INSTALL_TTS=true
WHISPER_MODELS_DIR=models/whisper
PIPER_MODELS_DIR=models/piper

# =============================================================================
# MCP Tool Server (optional)
# =============================================================================
MCP_ENABLED=false
MCP_AUTO_SEARCH=false
MCP_MAX_RESULTS=5
MCP_SERVER_CMD=python
MCP_SERVER_ARGS=services/mcp_server/server.py

# =============================================================================
# Default Model Configuration
# =============================================================================
# Provider to use when none is selected (openai, anthropic, ollama, etc.)
DEFAULT_LLM=ollama

# Default model (leave empty to use provider's first available model)
DEFAULT_MODEL=

# =============================================================================
# Speech-to-Text Configuration (faster-whisper)
# =============================================================================
# Model size: tiny, base, small, medium, large
# Recommended: tiny or base for 8GB RAM machines
WHISPER_MODEL_SIZE=tiny

# Device: cpu or cuda (NVIDIA GPU)
WHISPER_DEVICE=cpu

# Compute type: int8, float16, float32
# int8 is fastest and uses least memory
WHISPER_COMPUTE_TYPE=int8

# Language (ISO 639-1 code, e.g., en, es, fr)
WHISPER_LANGUAGE=en

# =============================================================================
# Text-to-Speech Configuration (Piper)
# =============================================================================
# Voice model name (must exist in models/piper directory)
PIPER_VOICE=en_US-lessac-medium
PRELOAD_TTS_MODEL=true

# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
PORT=8000
DEBUG=false

# =============================================================================
# Advanced Options
# =============================================================================
# Preload STT model on startup (set to true for faster first transcription)
PRELOAD_STT_MODEL=true
